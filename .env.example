# Todas las variables son opcionales.

# URL pública del sitio (sitemap, Open Graph, canonical). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Datos de contacto. Si quedan vacíos, el botón correspondiente no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Token de GitHub (solo servidor, NUNCA con prefijo NEXT_PUBLIC_).
# Sin token: 60 solicitudes/hora. Con token: 5000/hora. No necesita ningún permiso (scope).
# Generarlo en: GitHub → Settings → Developer settings → Personal access tokens (fine-grained).
GITHUB_TOKEN=

# Solo para pruebas locales con un servidor simulado.
# GITHUB_API_URL=https://api.github.com
